<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="820" viewBox="0 0 1200 820">
  <style>
    .title { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 22px; font-weight: 700; fill: #0A2540; letter-spacing: -0.2px; }
    .subtitle { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 12px; font-weight: 400; fill: #5E6B78; }
    .section { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 10px; font-weight: 700; fill: #0A2540; letter-spacing: 1.8px; }

    .arrow-label { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 10px; font-weight: 600; fill: #6E7B87; letter-spacing: 0.2px; text-anchor: middle; }

    .circle-label { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 14px; font-weight: 700; fill: #FFFFFF; text-anchor: middle; dominant-baseline: middle; }
    .circle-label-small { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 11px; font-weight: 700; fill: #FFFFFF; text-anchor: middle; dominant-baseline: middle; }

    .card-step { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 9px; font-weight: 700; fill: #005BAA; letter-spacing: 1.2px; }
    .card-title { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 12px; font-weight: 700; fill: #0A2540; }
    .card-text { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 10.5px; font-weight: 400; fill: #0A2540; }
    .card-text-soft { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 10px; font-weight: 400; fill: #6E6E6E; }

    .key-title { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 14px; font-weight: 700; fill: #0A2540; }
    .key-text { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 12px; font-weight: 400; fill: #0A2540; }

    .guide { stroke: #E3EAF1; stroke-width: 1.2; fill: none; }
    .connector { stroke: #B8C2CC; stroke-width: 1.7; fill: none; marker-end: url(#arrow); }
    .drop-line { stroke: #D5DEE7; stroke-width: 1.2; fill: none; }
    .card { fill: #F7F9FC; stroke: #D9E2EC; stroke-width: 1; }
  </style>

  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8.6" refY="5" markerWidth="5" markerHeight="5" orient="auto">
      <path d="M2 1L8 5L2 9" fill="none" stroke="#B8C2CC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <!-- Background -->
 

  <!-- Header -->
  <rect x="36" y="28" width="60" height="4" fill="#005BAA"/>
  <text class="title" x="36" y="62">SPV pool-sizing logic: how the pool shrinks at each step</text>
  <text class="subtitle" x="36" y="84">Circle size is illustrative. The visual shows the logic only: each filter removes part of the starting pool, leaving a much smaller fundable SPV amount.</text>

  <text class="section" x="36" y="122">POOL REDUCTION PATH</text>
  <text class="subtitle" x="1164" y="175" text-anchor="end">Smaller circle = smaller remaining pool</text>

  <!-- Baseline -->

  <!-- Connector labels -->
  <text class="arrow-label" x="206" y="216">Eligibility filter</text>
  <text class="arrow-label" x="388" y="228">Haircut</text>
  <text class="arrow-label" x="570" y="238">Advance rate</text>
  <text class="arrow-label" x="752" y="246">Adoption</text>
  <text class="arrow-label" x="934" y="252">Net of factor</text>

  <!-- Connectors -->
  <path d="M177 265 L245 272" class="connector"/>
  <path d="M349 272 L431 280" class="connector"/>
  <path d="M523 280 L614 287" class="connector"/>
  <path d="M697 287 L791 293" class="connector"/>
  <path d="M871 293 L1002 299" class="connector"/>

  <!-- Circles -->
  <circle cx="115" cy="265" r="62" fill="#0D4A8C"/>
  <text class="circle-label-small" x="115" y="259">GROSS</text>
  <text class="circle-label-small" x="115" y="275">TR</text>
  <line x1="115" y1="327" x2="115" y2="388" class="drop-line"/>

  <circle cx="297" cy="272" r="52" fill="#1C7FC1"/>
  <text class="circle-label" x="297" y="272">1</text>
  <line x1="297" y1="324" x2="297" y2="388" class="drop-line"/>

  <circle cx="479" cy="280" r="44" fill="#1C7FC1"/>
  <text class="circle-label" x="479" y="280">2</text>
  <line x1="479" y1="324" x2="479" y2="388" class="drop-line"/>

  <circle cx="661" cy="287" r="36" fill="#1C7FC1"/>
  <text class="circle-label" x="661" y="287">3</text>
  <line x1="661" y1="323" x2="661" y2="388" class="drop-line"/>

  <circle cx="843" cy="293" r="28" fill="#00A870"/>
  <text class="circle-label" x="843" y="293">4</text>
  <line x1="843" y1="321" x2="843" y2="388" class="drop-line"/>

  <circle cx="1025" cy="299" r="22" fill="#00A870"/>
  <text class="circle-label" x="1025" y="299">5</text>
  <line x1="1025" y1="321" x2="1025" y2="388" class="drop-line"/>

  <!-- Cards -->
  <!-- Card 0 -->
  <rect x="30" y="388" width="170" height="180" rx="2" class="card"/>
  <text class="card-step" x="44" y="410">STARTING BASE</text>
  <text class="card-title" x="44" y="432">Gross trade receivables</text>
  <line x1="44" y1="440" x2="186" y2="440" stroke="#D9E2EC" stroke-width="1"/>
  <text class="card-text" x="44" y="464">This is the broadest possible</text>
  <text class="card-text" x="44" y="481">starting pool before any SPV</text>
  <text class="card-text" x="44" y="498">filters are applied.</text>
  <text class="card-text-soft" x="44" y="524">It is the headline receivables</text>
  <text class="card-text-soft" x="44" y="540">base, not the amount that</text>
  <text class="card-text-soft" x="44" y="556">can actually be funded.</text>

  <!-- Card 1 -->
  <rect x="212" y="388" width="170" height="180" rx="2" class="card"/>
  <text class="card-step" x="226" y="410">STEP 1</text>
  <text class="card-title" x="226" y="432">Candidate pool</text>
  <line x1="226" y1="440" x2="368" y2="440" stroke="#D9E2EC" stroke-width="1"/>
  <text class="card-text" x="226" y="464">Keep only receivables that</text>
  <text class="card-text" x="226" y="481">fit the programme’s</text>
  <text class="card-text" x="226" y="498">eligibility criteria.</text>
  <text class="card-text-soft" x="226" y="524">Ineligible exposures drop out,</text>
  <text class="card-text-soft" x="226" y="540">so the pool immediately</text>
  <text class="card-text-soft" x="226" y="556">becomes smaller.</text>

  <!-- Card 2 -->
  <rect x="394" y="388" width="170" height="180" rx="2" class="card"/>
  <text class="card-step" x="408" y="410">STEP 2</text>
  <text class="card-title" x="408" y="432">Haircut</text>
  <line x1="408" y1="440" x2="550" y2="440" stroke="#D9E2EC" stroke-width="1"/>
  <text class="card-text" x="408" y="464">Apply a prudential cushion</text>
  <text class="card-text" x="408" y="481">to protect investors and</text>
  <text class="card-text" x="408" y="498">absorb ossible loss.</text>
  <text class="card-text-soft" x="408" y="524">This leaves extra collateral in</text>
  <text class="card-text-soft" x="408" y="540">the structure, reducing what</text>
  <text class="card-text-soft" x="408" y="556">is fundable.</text>

  <!-- Card 3 -->
  <rect x="576" y="388" width="170" height="180" rx="2" class="card"/>
  <text class="card-step" x="590" y="410">STEP 3</text>
  <text class="card-title" x="590" y="432">Advance rate</text>
  <line x1="590" y1="440" x2="732" y2="440" stroke="#D9E2EC" stroke-width="1"/>
  <text class="card-text" x="590" y="464">Lenders fund only a share</text>
  <text class="card-text" x="590" y="481">of remaining receivables,</text>
  <text class="card-text" x="590" y="498">not 100% of the pool.</text>
  <text class="card-text-soft" x="590" y="524">This converts the eligible pool</text>
  <text class="card-text-soft" x="590" y="540">into a smaller financed</text>
  <text class="card-text-soft" x="590" y="556">amount.</text>

  <!-- Card 4 -->
  <rect x="758" y="388" width="170" height="180" rx="2" class="card"/>
  <text class="card-step" x="772" y="410">STEP 4</text>
  <text class="card-title" x="772" y="432">Adoption</text>
  <line x1="772" y1="440" x2="914" y2="440" stroke="#D9E2EC" stroke-width="1"/>
  <text class="card-text" x="772" y="464">Assume partial year-one</text>
  <text class="card-text" x="772" y="481">utilisation rather than full</text>
  <text class="card-text" x="772" y="498">steady-state take-up.</text>
  <text class="card-text-soft" x="772" y="524">Structure may be available</text>
  <text class="card-text-soft" x="772" y="540">but the company does</text>
  <text class="card-text-soft" x="772" y="556">not use all of it immediately.</text>

  <!-- Card 5 -->
  <rect x="940" y="388" width="170" height="180" rx="2" class="card"/>
  <text class="card-step" x="954" y="410">STEP 5</text>
  <text class="card-title" x="954" y="432">Net of factor</text>
  <line x1="954" y1="440" x2="1096" y2="440" stroke="#D9E2EC" stroke-width="1"/>
  <text class="card-text" x="954" y="464">Remove receivables already</text>
  <text class="card-text" x="954" y="481">factored or financed</text>
  <text class="card-text" x="954" y="498">elsewhere.</text>
  <text class="card-text-soft" x="954" y="524">This avoids double counting</text>
  <text class="card-text-soft" x="954" y="540">and leaves the final net</text>
  <text class="card-text-soft" x="954" y="556">fundable SPV pool.</text>

  <!-- Key message -->
  <rect x="30" y="612" width="1080" height="106" rx="2" fill="#F7F9FC" stroke="#D9E2EC" stroke-width="1"/>
  <rect x="30" y="612" width="6" height="106" fill="#00A870"/>
  <text class="key-title" x="56" y="646">Key message</text>
  <text class="key-text" x="56" y="675">The SPV is not sized from gross receivables.</text>
  <text class="key-text" x="56" y="700">Each deduction narrows the pool, so the eventual fundable amount is much smaller than the starting receivables base.</text>

  <!-- Footer -->
  <text class="subtitle" x="30" y="772">Illustrative, not to exact proportional scale. Sequence shown: gross TR → candidate pool → haircut → advance rate → adoption → net of factor.</text>
</svg>