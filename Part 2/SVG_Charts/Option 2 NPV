<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="590" viewBox="0 0 1000 590">
  <style>
    .bg { fill: #FFFFFF; }
    .title { font-family: Arial, Helvetica, sans-serif; font-size: 28px; font-weight: 700; fill: #0A2540; }
    .subtitle { font-family: Arial, Helvetica, sans-serif; font-size: 14px; fill: #5E6B78; }
    .label { font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 700; fill: #0A2540; text-anchor: middle; }
    .value { font-family: Arial, Helvetica, sans-serif; font-size: 22px; font-weight: 700; fill: #0A2540; text-anchor: middle; }
    .value-inverse { font-family: Arial, Helvetica, sans-serif; font-size: 22px; font-weight: 700; fill: #FFFFFF; text-anchor: middle; }
    .axis { stroke: #D5DEE7; stroke-width: 2; }
    .connector { stroke: #A7B4C2; stroke-width: 2; stroke-dasharray: 7 7; }
    .bar-red { fill: #B94A48; }
    .bar-green-light { fill: #C8D6BF; }
    .bar-green-dark { fill: #1F5E4A; }
    .panel { fill: #F7F9FC; stroke: #D9E2EC; stroke-width: 1; }
    .accent { fill: #1F5E4A; }
    .note-title { font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 700; fill: #0A2540; }
    .note-text { font-family: Arial, Helvetica, sans-serif; font-size: 13px; fill: #0A2540; }
  </style>

  <rect x="70" y="34" width="66" height="5" class="accent"/>
  <text x="70" y="68" class="title">SPV NPV progression vs baseline</text>
  <text x="70" y="92" class="subtitle">Funding relief is negative and drops below zero; NFR relief then lifts total NPV to a strongly positive outcome.</text>

  <line x1="70" y1="400" x2="940" y2="400" class="axis"/>

  <rect x="180" y="400" width="170" height="37.2" rx="6" class="bar-red"/>
  <text x="265.0" y="465.2" class="value">(6.2)</text>
  <text x="265.0" y="486" class="label">PV of funding relief</text>

  <line x1="350" y1="437.2" x2="420" y2="437.2" class="connector"/>
  <rect x="420" y="160.5" width="170" height="276.7" rx="6" class="bar-green-light"/>
  <text x="505.0" y="146.5" class="value">+916.5</text>
  <text x="505.0" y="486" class="label">PV of NFR relief</text>

  <line x1="590" y1="160.5" x2="660" y2="160.5" class="connector"/>
  <rect x="660" y="160.5" width="170" height="239.5" rx="6" class="bar-green-dark"/>
  <text x="745.0" y="196.5" class="value-inverse">910.2</text>
  <text x="745.0" y="486" class="label">TOTAL vs baseline</text>


</svg>