<svg xmlns="http://www.w3.org/2000/svg" width="680" height="500" viewBox="0 0 680 500">
<style>
.title { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 18px; font-weight: 700; fill: #0A2540; letter-spacing: -0.2px; }
.subtitle { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 12px; font-weight: 400; fill: #6E6E6E; }
.decision-title { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 13px; font-weight: 600; fill: #FFFFFF; }
.decision-sub { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 11px; font-weight: 400; fill: #FFFFFF; opacity: 0.82; }
.branch-label { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 11px; font-weight: 600; fill: #0A2540; letter-spacing: 0.5px; }
.outcome-title { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 14px; font-weight: 600; fill: #FFFFFF; }
.outcome-item { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 11px; font-weight: 400; fill: #FFFFFF; opacity: 0.9; }
.outcome-footer { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 10px; font-weight: 500; fill: #FFFFFF; opacity: 0.75; font-style: italic; }
.footer { font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif; font-size: 11px; font-weight: 400; fill: #3D3D3A; }
</style>
<defs>
<marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="#0A2540" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker>
</defs>

<rect x="40" y="24" width="48" height="3" fill="#003D7A"/>
<text class="title" x="40" y="54">Moody's accounting treatment</text>
<text class="subtitle" x="40" y="74">The SPV's rating impact depends on one binary test under Moody's Approach (2022)</text>

<rect x="240" y="108" width="200" height="64" rx="2" fill="#0A2540"/>
<text class="decision-title" x="340" y="134" text-anchor="middle">SPV sale of receivables</text>
<text class="decision-sub" x="340" y="156" text-anchor="middle">Does it pass the true-sale test?</text>

<line x1="290" y1="172" x2="180" y2="214" stroke="#0A2540" stroke-width="1.4" marker-end="url(#arrow)"/>
<line x1="390" y1="172" x2="500" y2="214" stroke="#0A2540" stroke-width="1.4" marker-end="url(#arrow)"/>

<rect x="215" y="186" width="32" height="18" rx="9" fill="#FFFFFF" stroke="#00A651" stroke-width="1.2"/>
<text class="branch-label" x="231" y="199" text-anchor="middle" style="fill: #00A651;">YES</text>

<rect x="433" y="186" width="32" height="18" rx="9" fill="#FFFFFF" stroke="#6E6E6E" stroke-width="1.2"/>
<text class="branch-label" x="449" y="199" text-anchor="middle" style="fill: #6E6E6E;">NO</text>

<rect x="40" y="224" width="280" height="210" rx="2" fill="#00A651"/>
<text class="outcome-title" x="180" y="252" text-anchor="middle">True sale satisfied</text>
<line x1="80" y1="264" x2="280" y2="264" stroke="#FFFFFF" stroke-width="0.5" opacity="0.3"/>
<text class="outcome-item" x="180" y="288" text-anchor="middle">Receivables move off balance sheet</text>
<text class="outcome-item" x="180" y="310" text-anchor="middle">Cash received reduces net debt</text>
<text class="outcome-item" x="180" y="332" text-anchor="middle">Leverage ratios improve</text>
<text class="outcome-item" x="180" y="354" text-anchor="middle">Rating metrics move favourably</text>
<line x1="80" y1="380" x2="280" y2="380" stroke="#FFFFFF" stroke-width="0.5" opacity="0.3"/>
<text class="outcome-footer" x="180" y="405" text-anchor="middle">Section 5 reports as True Sale case</text>

<rect x="360" y="224" width="280" height="210" rx="2" fill="#6E6E6E"/>
<text class="outcome-title" x="500" y="252" text-anchor="middle">Recharacterised as borrowing</text>
<line x1="400" y1="264" x2="600" y2="264" stroke="#FFFFFF" stroke-width="0.5" opacity="0.3"/>
<text class="outcome-item" x="500" y="288" text-anchor="middle">Receivables stay on balance sheet</text>
<text class="outcome-item" x="500" y="310" text-anchor="middle">SPV funding recognised as debt</text>
<text class="outcome-item" x="500" y="332" text-anchor="middle">Leverage unchanged</text>
<text class="outcome-item" x="500" y="354" text-anchor="middle">Operational cash benefit still applies</text>
<line x1="400" y1="380" x2="600" y2="380" stroke="#FFFFFF" stroke-width="0.5" opacity="0.3"/>
<text class="outcome-footer" x="500" y="405" text-anchor="middle">Section 5 reports as Secured case</text>

<rect x="40" y="460" width="3" height="32" fill="#003D7A"/>
<text class="footer" x="54" y="474">The model runs both cases in parallel. Section 5 presents results side by side so</text>
<text class="footer" x="54" y="489">the reader can weigh the option on rating and operational merits independently.</text>
</svg>