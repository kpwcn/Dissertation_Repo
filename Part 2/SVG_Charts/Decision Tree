<rect x="40" y="24" width="48" height="3" fill="#003D7A"/>
<text class="title" x="40" y="54">Decision tree: gated path from authorisation to steady state</text>
<text class="subtitle" x="40" y="74">Three gates, KPI-driven kill criteria. Success path runs centre. Degraded outcomes branch right.</text>

<text class="section" x="40" y="116">PROGRAMME GOVERNANCE</text>

<!-- START node (centred at x=420) -->
<rect x="280" y="140" width="280" height="42" rx="2" fill="#0A2540"/>
<text class="start-label" x="420" y="167" text-anchor="middle">Programme authorised by Board</text>

<line x1="420" y1="182" x2="420" y2="212" stroke="#B8C2CC" stroke-width="1.5" marker-end="url(#arrow)"/>

<!-- GATE 1: 360px wide, centred at 420 -->
<rect x="240" y="216" width="360" height="120" rx="2" fill="#003D7A"/>
<text class="node-title" x="256" y="238">GATE 1 · PRE-LAUNCH READINESS</text>
<line x1="256" y1="246" x2="584" y2="246" stroke="#FFFFFF" stroke-width="0.6" opacity="0.3"/>
